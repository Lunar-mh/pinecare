# ==========================================
# SilverCare backend environment template
# Fresh Docker + host development defaults
# ==========================================

# Runtime mode
# - COMPETITION_SANDBOX: allow mock fallback for external services
# - PRODUCTION_LIVE: disable mock fallback and require real integrations
RUNTIME_MODE=COMPETITION_SANDBOX
COMPETITION_SANDBOX=1
PRODUCTION_LIVE=0
NODE_ENV=development
PORT=3000
SERVER_ROLE=api
TRUST_PROXY=loopback
JSON_BODY_LIMIT=1mb
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database
# Host-side scripts use 127.0.0.1:3306.
# Docker backend overrides DB_HOST to mysql via docker-compose.
DB_HOST=127.0.0.1
DB_PORT=13307
DB_USER=yinban
DB_PASSWORD=yinban_password
DB_NAME=yinban
MYSQL_ROOT_PASSWORD=root_password

# Redis
# Host-side scripts use 127.0.0.1:6379.
# Docker backend overrides REDIS_HOST to redis via docker-compose.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth
# In PRODUCTION_LIVE mode, ADMIN_USERNAME and ADMIN_PASSWORD are mandatory.
# Avoid weak defaults and rotate these values before deployment.
JWT_SECRET=yinban_jwt_secret_a1b2c3d4e5f6789012345678abcdef00
JWT_REFRESH_SECRET=yinban_refresh_secret_a1b2c3d4e5f6789012345678ab
ADMIN_USERNAME=admin-root
ADMIN_PASSWORD=change-me-admin-password-123

# WeChat login
WX_APPID=
WX_APPSECRET=

# SMS (general)
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=银伴平台
ALIYUN_SMS_TEMPLATE_CODE=

# AI / LLM
AI_CONSULT_MODE=auto
AI_CONSULT_TIMEOUT_MS=30000
AI_CONSULT_MAX_RETRY=2
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-turbo
QWEN_TIMEOUT_MS=30000

# Voice
VOICE_SERVICE_MODE=auto
VOICE_SERVICE_TIMEOUT_MS=15000
VOICE_SERVICE_MAX_RETRY=2
ALIYUN_ASR_ENDPOINT=https://nls-gateway-cn-shanghai.aliyuncs.com/stream/v1/asr
ALIYUN_TTS_ENDPOINT=https://nls-gateway-cn-shanghai.aliyuncs.com/stream/v1/tts
ALIYUN_VOICE_TIMEOUT_MS=20000

# OSS upload
OSS_MODE=stub
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=yinban-family-space
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_TIMEOUT_MS=10000
OSS_MAX_RETRY=2
OSS_UPLOAD_API_URL=
OSS_UPLOAD_TOKEN=
OSS_PUBLIC_BASE_URL=

# Medical integration
MEDICAL_API_MODE=auto
MEDICAL_API_BASE_URL=
MEDICAL_API_KEY=
MEDICAL_API_AUTH_MODE=bearer
MEDICAL_API_TIMEOUT_MS=5000
MEDICAL_API_MAX_RETRY=2
MEDICAL_API_CIRCUIT_BREAKER_THRESHOLD=3
MEDICAL_API_CIRCUIT_BREAKER_COOLDOWN_MS=30000
MEDICAL_API_ALLOW_STUB_FALLBACK=true

# WeChat notify (medication/family)
# Set WECHAT_NOTIFY_MOCK=0 in PRODUCTION_LIVE mode
WX_ACCESS_TOKEN=
WECHAT_NOTIFY_API_URL=https://api.weixin.qq.com/cgi-bin/message/subscribe/send
WECHAT_NOTIFY_TIMEOUT=5000
WECHAT_NOTIFY_MOCK=1
WECHAT_MINI_PROGRAM_STATE=formal
WX_MSG_TEMPLATE_ID=
WX_MSG_TEMPLATE_ID_FAMILY=
WX_MSG_TEMPLATE_ID_REFILL=
WX_MSG_TEMPLATE_ID_SECOND=

# SOS notify
SOS_SMS_MODE=auto
SOS_SMS_PROVIDER=aliyun
SOS_SMS_NOTIFY_URL=
SOS_SMS_SIGN_NAME=
SOS_SMS_TEMPLATE_CODE=SOS_ALERT_TEMPLATE
SOS_SMS_API_URL=https://dysmsapi.aliyuncs.com/
SOS_SMS_REGION_ID=cn-hangzhou
SOS_SMS_TIMEOUT_MS=5000
SOS_WECHAT_MODE=auto
SOS_WECHAT_NOTIFY_URL=
SOS_WX_MSG_TEMPLATE_ID=
SOS_WECHAT_PAGE=pages/sos/index
SOS_WX_FIELD_CONTACT=thing1
SOS_WX_FIELD_ADDRESS=thing2
SOS_WX_FIELD_TIME=time3
SOS_WX_FIELD_COORDS=thing4
SOS_WECHAT_TIMEOUT_MS=5000
SOS_NOTIFY_MAX_RETRY=3
SOS_NOTIFY_DEDUPE_TTL_SECONDS=120
SOS_QUEUE_KEY=sos:notify:queue
SOS_QUEUE_BATCH_SIZE=10
SOS_QUEUE_POLL_INTERVAL_MS=5000
SOS_AUTO_RESOLVE_CRON=*/5 * * * *
SOS_AUTO_RESOLVE_TIMEOUT_MINUTES=30
SOS_AUTO_RESOLVE_LOCK_KEY=sos:auto_resolve:lock
SOS_AUTO_RESOLVE_LOCK_TTL_MS=15000
SOS_LOCK_TTL_MS=10000

# Fall detection
FALL_COUNTDOWN_SECONDS=30
FALL_NOTIFY_TIMEOUT_MS=5000
FALL_NOTIFY_RETRY_TIMES=2
FALL_NOTIFY_RETRY_DELAY_MS=1000
FALL_SMS_NOTIFY_URL=
FALL_WECHAT_NOTIFY_URL=
FALL_SETTINGS_CACHE_TTL=60

# Misc
HASH_SECRET=yinban_hash_secret_demo
ENABLE_MEDICATION_JOBS=1
ADMIN_DEFAULT_COMMUNITY_ID=101
PLATFORM_PRIVATE_KEY=
