# ==========================================
# 閾朵即骞冲彴鍚庣鐜鍙橀噺閰嶇疆妯℃澘
# 澶嶅埗鏈枃浠朵负 .env 骞跺～鍏ュ疄闄呭€?# ==========================================

# 鏁版嵁搴撻厤缃?DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=yinban

# Redis閰嶇疆
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT璁よ瘉
JWT_SECRET=your_jwt_secret_change_in_production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# 鏈嶅姟绔彛
PORT=3000

# ==========================================
# 001-user-auth: 鐭俊涓庡井淇＄櫥褰?# ==========================================
ALIYUN_ACCESS_KEY_ID=your_access_key_id
ALIYUN_ACCESS_KEY_SECRET=your_access_key_secret
ALIYUN_SMS_SIGN_NAME=閾朵即骞冲彴
ALIYUN_SMS_TEMPLATE_CODE=SMS_xxxxxxxx
WX_APP_ID=your_wx_app_id
WX_APP_SECRET=your_wx_app_secret

# ==========================================
# 008-ai-health-advice: AI鍋ュ悍椤鹃棶
# ==========================================
DASHSCOPE_API_KEY=your_dashscope_api_key
CONTENT_SAFETY_ENDPOINT=https://green-cn-hangzhou.aliyuncs.com

# ==========================================
# 003-medication-reminder: 鐢ㄨ嵂鎻愰啋
# ==========================================
WX_MSG_TEMPLATE_ID=your_template_id

# ==========================================
# 006-voice-interaction: 璇煶浜や簰
# ==========================================
XUNFEI_APP_ID=your_xunfei_app_id
XUNFEI_API_KEY=your_xunfei_api_key
XUNFEI_API_SECRET=your_xunfei_api_secret

# ==========================================
# 012-family-space: 瀹跺涵绌洪棿
# ==========================================
OSS_ACCESS_KEY_ID=your_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
OSS_BUCKET=yinban-family-space
OSS_REGION=oss-cn-hangzhou
OSS_BASE_URL=https://yinban-family-space.oss-cn-hangzhou.aliyuncs.com

# ==========================================
# 014-gps-tracking: GPS瀹氫綅杩借釜
# ==========================================
AMAP_API_KEY=your_amap_api_key

# ==========================================
# 015-medical-integration: 鍖荤枟鏈烘瀯瀵规帴
# ==========================================
HIS_API_BASE_URL=https://his.hospital.com/api
HIS_API_KEY=your_his_api_key
HIS_API_SECRET=your_his_api_secret

# Admin console login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

