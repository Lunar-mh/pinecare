    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.26.3",
    "@babel/preset-typescript": "^7.26.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@tarojs/cli": "^4.1.11",
    "@tarojs/plugin-framework-react": "^4.1.11",
