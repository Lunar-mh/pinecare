.sos-overview-page__family-badge{align-items:center;background:hsla(0,0%,100%,.16);border-radius:50%;display:flex;height:88rpx;justify-content:center;width:88rpx}.sos-overview-page__scroll{max-height:calc(100vh - 440rpx)}.sos-overview-page__stack{display:grid;gap:32rpx}.sos-overview-page__text,.sos-overview-page__title{display:block}.sos-overview-page__title{color:#22303a;font-size:44rpx;font-weight:700}.sos-overview-page__text{color:#596570;font-size:32rpx;line-height:1.7;margin-top:16rpx}.sos-overview-page__actions{display:flex;flex-wrap:wrap;gap:24rpx;margin-top:32rpx}.sos-overview-page__button{align-items:center;background:rgba(47,108,91,.1);border-radius:1998rpx;color:#2f6c5b;display:inline-flex;font-size:30rpx;font-weight:600;gap:16rpx;justify-content:center;min-height:88rpx;padding:0 36rpx}.sos-overview-page__button--danger{background:rgba(215,90,74,.12);color:#d75a4a}.sos-overview-page__bottom-space{height:240rpx}