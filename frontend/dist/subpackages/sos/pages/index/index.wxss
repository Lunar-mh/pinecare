.sos-page{background:#f5f5f0;min-height:100vh;padding:32rpx}.sos-page .sos-header{background:linear-gradient(180deg,#ffebee,#f5f5f0);margin:-32rpx -32rpx 40rpx;padding:80rpx 40rpx;text-align:center}.sos-page .sos-header__title{color:#c62828;display:block;font-size:72rpx;font-weight:800;margin-bottom:16rpx}.sos-page .sos-header__desc{color:#666;font-size:36rpx}.sos-page .sos-trigger-area{display:flex;justify-content:center;padding:40rpx 0 80rpx;position:relative}.sos-page .sos-trigger-area .sos-button{align-items:center;background:linear-gradient(135deg,#ef5350,#d32f2f);border-radius:50%;box-shadow:0 24rpx 64rpx rgba(211,47,47,.4),inset 0 8rpx 24rpx hsla(0,0%,100%,.3);display:flex;height:480rpx;justify-content:center;position:relative;transition:transform .2s cubic-bezier(.34,1.56,.64,1);width:480rpx;z-index:10}.sos-page .sos-trigger-area .sos-button:active{transform:scale(.92)}.sos-page .sos-trigger-area .sos-button__progress{background:#f5f5f0;border-radius:50%;inset:-16rpx;mask:radial-gradient(transparent 65%,#000 66%);-webkit-mask:radial-gradient(transparent 65%,#000 66%);padding:16rpx;position:absolute}.sos-page .sos-trigger-area .sos-button__inner{align-items:center;display:flex;flex-direction:column;gap:16rpx;z-index:1}.sos-page .sos-trigger-area .sos-button__text{color:#fff;font-size:48rpx;font-weight:700}.sos-page .sos-trigger-area .sos-ripple{animation:ripple 1.5s ease-out infinite;border:4rpx solid rgba(239,68,68,.5);border-radius:50%;inset:0;position:absolute}.sos-page .sos-trigger-area .sos-ripple--2{animation-delay:.5s}.sos-page .sos-trigger-area .sos-active-card{background:linear-gradient(135deg,#ef4444,#dc2626);border-radius:48rpx;box-shadow:0 16rpx 48rpx rgba(239,68,68,.3);color:#fff;max-width:640rpx;padding:80rpx 64rpx;text-align:center;width:100%}.sos-page .sos-trigger-area .sos-active-card .sos-active-icon{align-items:center;background:hsla(0,0%,100%,.2);border-radius:50%;display:flex;height:160rpx;justify-content:center;margin:0 auto 40rpx;width:160rpx}.sos-page .sos-trigger-area .sos-active-card .sos-active-title{font-size:56rpx;font-weight:700;margin-bottom:24rpx}.sos-page .sos-trigger-area .sos-active-card .sos-active-time{font-size:32rpx;margin-bottom:32rpx;opacity:.9}.sos-page .sos-trigger-area .sos-active-card .sos-active-desc{font-size:36rpx;line-height:1.5;margin-bottom:48rpx;opacity:.9}.sos-page .sos-trigger-area .sos-active-card .sos-cancel-btn{background:hsla(0,0%,100%,.2);border:4rpx solid hsla(0,0%,100%,.5);border-radius:24rpx;display:inline-block;font-size:36rpx;font-weight:500;padding:32rpx 64rpx;transition:all .2s ease}.sos-page .sos-trigger-area .sos-active-card .sos-cancel-btn:active{background:hsla(0,0%,100%,.3)}@keyframes ripple{0%{opacity:1;transform:scale(1)}100%{opacity:0;transform:scale(1.5)}}.sos-page .emergency-contacts{margin-top:64rpx}.sos-page .emergency-contacts .section-title{color:#1a1a1a;display:block;font-size:40rpx;font-weight:700;margin-bottom:32rpx}.sos-page .emergency-contacts .contact-list{display:flex;flex-direction:column;gap:24rpx}.sos-page .emergency-contacts .contact-item{align-items:center;background:#fff;border-radius:32rpx;box-shadow:0 8rpx 24rpx rgba(0,0,0,.1);display:flex;padding:40rpx;transition:transform .2s ease}.sos-page .emergency-contacts .contact-item:active{transform:scale(.98)}.sos-page .emergency-contacts .contact-item--emergency{background:linear-gradient(135deg,#ef4444,#dc2626);color:#fff}.sos-page .emergency-contacts .contact-item--emergency .contact-name,.sos-page .emergency-contacts .contact-item--emergency .contact-number{color:#fff}.sos-page .emergency-contacts .contact-item--emergency .contact-action__text{background:#fff;color:#ef4444}.sos-page .emergency-contacts .contact-item .contact-icon{align-items:center;background:rgba(239,68,68,.1);border-radius:50%;display:flex;height:112rpx;justify-content:center;margin-right:32rpx;width:112rpx}.sos-page .emergency-contacts .contact-item .contact-info{flex:1}.sos-page .emergency-contacts .contact-item .contact-info .contact-name{color:#1a1a1a;font-size:40rpx;font-weight:700;margin-bottom:8rpx}.sos-page .emergency-contacts .contact-item .contact-info .contact-number{color:#01579b;font-size:48rpx;font-weight:700}.sos-page .emergency-contacts .contact-item .contact-info .contact-desc{color:#666;font-size:32rpx}.sos-page .emergency-contacts .contact-item .contact-action__text{background:#01579b;border-radius:40rpx;color:#fff;font-size:32rpx;font-weight:500;padding:20rpx 40rpx}.sos-page .sos-guide{margin-top:64rpx}.sos-page .sos-guide .section-title{color:#1a1a1a;display:block;font-size:40rpx;font-weight:700;margin-bottom:32rpx}.sos-page .sos-guide .guide-list{background:#fff;border-radius:32rpx;box-shadow:0 8rpx 24rpx rgba(0,0,0,.1);padding:40rpx}.sos-page .sos-guide .guide-item{align-items:flex-start;border-bottom:2rpx solid #e0e0e0;display:flex;gap:32rpx;padding:32rpx 0}.sos-page .sos-guide .guide-item:last-child{border-bottom:none;padding-bottom:0}.sos-page .sos-guide .guide-item:first-child{padding-top:0}.sos-page .sos-guide .guide-item .guide-number{align-items:center;background:#01579b;border-radius:50%;color:#fff;display:flex;flex-shrink:0;font-size:32rpx;font-weight:700;height:64rpx;justify-content:center;width:64rpx}.sos-page .sos-guide .guide-item .guide-text{color:#1a1a1a;flex:1;font-size:36rpx;line-height:1.6;padding-top:8rpx}.sos-page .sos-warning{align-items:center;background:#fff8e1;border-radius:24rpx;display:flex;gap:24rpx;margin-top:48rpx;padding:32rpx 40rpx}.sos-page .sos-warning__text{color:#f57c00;flex:1;font-size:32rpx;line-height:1.5}.sos-page .safe-area-bottom{height:constant(safe-area-inset-bottom);height:env(safe-area-inset-bottom);min-height:40rpx}@media (prefers-reduced-motion:reduce){.sos-page .sos-ripple{animation:none}.sos-page .sos-button{transition:none}}