.medication-overview-page__scroll{max-height:calc(100vh - 440rpx)}.medication-overview-page__grid,.medication-overview-page__stack{display:grid;gap:32rpx}.medication-overview-page__progress-ring{align-items:center;background:hsla(0,0%,100%,.16);border:4rpx solid hsla(0,0%,100%,.22);border-radius:50%;color:#fff;display:flex;font-size:44rpx;font-weight:700;height:172rpx;justify-content:center;width:172rpx}.medication-overview-page__tabs{display:grid;gap:24rpx;grid-template-columns:repeat(2,minmax(0,1fr));margin-bottom:48rpx}.medication-overview-page__tab{align-items:center;background:rgba(255,253,249,.85);border:2rpx solid hsla(35,39%,88%,.9);border-radius:36rpx;color:#596570;display:flex;font-size:36rpx;font-weight:600;justify-content:center;min-height:104rpx}.medication-overview-page__tab--active{background:linear-gradient(135deg,#2f6c5b,#438470);box-shadow:0 20rpx 48rpx rgba(47,108,91,.18);color:#fff}.medication-overview-page__item-desc,.medication-overview-page__item-meta,.medication-overview-page__item-title,.medication-overview-page__panel-text{display:block}.medication-overview-page__panel-text{color:#596570;font-size:36rpx}.medication-overview-page__item-title{color:#22303a;font-size:44rpx;font-weight:700}.medication-overview-page__item-desc,.medication-overview-page__item-meta{color:#596570;font-size:32rpx;line-height:1.55;margin-top:16rpx}.medication-overview-page__actions{display:flex;flex-wrap:wrap;gap:24rpx;margin-top:32rpx}.medication-overview-page__btn{align-items:center;background:rgba(47,108,91,.1);border-radius:1998rpx;color:#2f6c5b;display:inline-flex;font-size:30rpx;font-weight:600;justify-content:center;min-height:88rpx;padding:0 36rpx}.medication-overview-page__btn--primary{background:#2f6c5b;color:#fff}.medication-overview-page__btn--danger{background:rgba(215,90,74,.12);color:#d75a4a}.medication-overview-page__bottom-space{height:240rpx}