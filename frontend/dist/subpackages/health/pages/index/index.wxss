.health-overview-page__scroll{max-height:calc(100vh - 440rpx)}.health-overview-page__header-badge{background:hsla(0,0%,100%,.18);border-radius:1998rpx;color:#fff;font-size:32rpx;font-weight:600;padding:24rpx 32rpx}.health-overview-page__grid,.health-overview-page__stack{display:grid;gap:32rpx}.health-overview-page__alert-desc,.health-overview-page__alert-title,.health-overview-page__dismiss,.health-overview-page__panel-text{display:block}.health-overview-page__panel-text{color:#596570;font-size:36rpx;line-height:1.55}.health-overview-page__alert-row{align-items:flex-start;display:flex;gap:32rpx;justify-content:space-between}.health-overview-page__alert-title{color:#22303a;font-size:44rpx;font-weight:700}.health-overview-page__alert-desc{color:#596570;font-size:32rpx;line-height:1.7;margin-top:20rpx}.health-overview-page__dismiss{background:rgba(47,108,91,.12);border-radius:1998rpx;color:#2f6c5b;flex-shrink:0;font-size:30rpx;font-weight:600;padding:20rpx 32rpx}.health-overview-page__bottom-space{height:240rpx}