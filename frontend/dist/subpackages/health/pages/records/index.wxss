.records-page{background:#f6f1e7;display:flex;flex-direction:column;height:100vh}.records-nav{align-items:center;background:#fffdf9;display:flex;flex-shrink:0;justify-content:space-between;padding:96rpx 32rpx 32rpx}.records-nav__back{align-items:center;display:flex;height:88rpx;justify-content:center;transform:rotate(180deg);width:88rpx}.records-nav__title{color:#22303a;font-size:56rpx;font-weight:700}.records-nav__placeholder{width:88rpx}.type-tabs{background:#fffdf9;border-bottom:2rpx solid #ece2d4;display:flex;flex-shrink:0;gap:24rpx;padding:0 32rpx 24rpx}.type-tabs__item{align-items:center;border-radius:36rpx;color:#596570;display:flex;flex:1;font-size:40rpx;font-weight:500;height:88rpx;justify-content:center;position:relative}.type-tabs__item--active{color:#2f6c5b;font-weight:600}.type-tabs__item--active::after{background:#2f6c5b;border-radius:4rpx;bottom:-24rpx;content:"";height:6rpx;left:20%;position:absolute;width:60%}.records-scroll{flex:1;overflow:hidden}.records-list{display:flex;flex-direction:column;gap:24rpx;padding:32rpx}.record-item{align-items:center;background:#fffdf9;border-radius:52rpx;box-shadow:0 24rpx 60rpx rgba(51,65,78,.08);display:flex;justify-content:space-between;padding:32rpx}.record-item__left{align-items:center;display:flex;flex:1;gap:24rpx}.record-item__icon-wrap{align-items:center;border-radius:36rpx;display:flex;flex-shrink:0;height:88rpx;justify-content:center;width:88rpx}.record-item__info{flex:1}.record-item__value-row{align-items:baseline;display:flex;gap:8rpx;margin-bottom:4rpx}.record-item__value{color:#22303a;font-size:56rpx;font-weight:700;line-height:1.2}.record-item__unit{color:#596570;font-size:32rpx}.record-item__sub{color:#8d98a3;display:block;font-size:32rpx;margin-bottom:4rpx}.record-item__time{color:#8d98a3;display:block;font-size:32rpx}.record-item__badge{align-items:center;border-radius:24rpx;display:flex;flex-shrink:0;font-size:32rpx;font-weight:500;gap:8rpx;padding:8rpx 20rpx}.record-item__badge--normal{background:#e8f5e9;color:#4b8d63}.record-item__badge--warning{background:#fff3e0;color:#d99a3e}.record-item__badge--danger{background:#ffebee;color:#d75a4a}.records-empty{align-items:center;display:flex;flex-direction:column;gap:24rpx;justify-content:center;padding:96rpx 32rpx}.records-empty__text{color:#8d98a3;font-size:48rpx;font-weight:500}.records-empty__hint{color:#bcc5ce;font-size:32rpx}.records-end,.records-loading{display:flex;justify-content:center;padding:48rpx 0}.records-end__text,.records-loading__text{color:#8d98a3;font-size:32rpx}