.trend-page{background:#f5f5f0;min-height:100vh;padding-bottom:96rpx}.trend-nav{align-items:center;background:#fff;display:flex;justify-content:space-between;padding:96rpx 32rpx 32rpx}.trend-nav__back{align-items:center;display:flex;height:88rpx;justify-content:center;transform:rotate(180deg);width:88rpx}.trend-nav__title{color:#1a1a1a;font-size:48rpx;font-weight:700}.trend-nav__placeholder{width:88rpx}.period-tabs{background:#fff;display:flex;gap:24rpx;padding:0 32rpx 24rpx}.period-tabs__item{align-items:center;border:4rpx solid #e0e0e0;border-radius:24rpx;color:#666;display:flex;flex:1;font-size:40rpx;font-weight:500;height:88rpx;justify-content:center;transition:all .2s}.period-tabs__item--active{background:#e3f2fd;border-color:#01579b;color:#01579b;font-weight:600}.trend-loading{align-items:center;display:flex;height:400rpx;justify-content:center}.trend-loading__text{color:#999;font-size:40rpx}.trend-content{display:flex;flex-direction:column;gap:32rpx;padding:32rpx}.chart-card{background:#fff;border-radius:32rpx;box-shadow:0 8rpx 24rpx rgba(0,0,0,.1);padding:48rpx}.chart-card__header{align-items:center;display:flex;gap:24rpx;margin-bottom:24rpx}.chart-card__icon-wrap{align-items:center;border-radius:16rpx;display:flex;height:72rpx;justify-content:center;width:72rpx}.chart-card__title{color:#1a1a1a;font-size:40rpx;font-weight:600}.chart-card__legend{display:flex;gap:48rpx;margin-bottom:32rpx}.chart-card__reference{border-top:2rpx solid #e0e0e0;margin-top:24rpx;padding-top:24rpx}.chart-card__reference-text{color:#999;font-size:24rpx}.legend-item{align-items:center;display:flex;gap:16rpx}.legend-item__dot{border-radius:50%;height:20rpx;width:20rpx}.legend-item__label{color:#666;font-size:32rpx}.bar-chart{align-items:flex-end;display:flex;gap:8rpx;height:280rpx;justify-content:space-between;padding:0 16rpx}.bar-chart__col{align-items:center;display:flex;flex:1;flex-direction:column;height:100%}.bar-chart__bars{align-items:flex-end;display:flex;flex:1;justify-content:center;width:100%}.bar-chart__bar-group{align-items:flex-end;display:flex;gap:4rpx;height:100%;justify-content:center;width:100%}.bar-chart__bar{border-radius:6rpx 6rpx 0 0;flex:1;min-width:16rpx;transition:height .3s}.bar-chart__bar--systolic{background:#ff6b6b}.bar-chart__bar--diastolic{background:#4ecdc4}.bar-chart__bar--hr{background:#e53935}.bar-chart__label{color:#999;font-size:20rpx;line-height:1.2;margin-top:8rpx;text-align:center}.bar-chart--single .bar-chart__bars{padding:0 16rpx}.chart-empty{align-items:center;display:flex;height:200rpx;justify-content:center}.chart-empty__text{color:#999;font-size:40rpx}.health-tip{background:#e3f2fd;border-left:8rpx solid #01579b;border-radius:32rpx;padding:32rpx}.health-tip__title{color:#01579b;display:block;font-size:40rpx;font-weight:600;margin-bottom:16rpx}.health-tip__text{color:#666;font-size:32rpx;line-height:1.6}