.alert-banner{align-items:flex-start;border-left-style:solid;border-left-width:8rpx;border-radius:32rpx;display:flex;justify-content:space-between;margin-bottom:32rpx;padding:40rpx 48rpx;transition:all .3s ease-in-out;width:100%}.alert-banner__content{align-items:flex-start;display:flex;flex:1;gap:32rpx}.alert-banner__icon{align-items:center;display:flex;flex-shrink:0;height:64rpx;justify-content:center;margin-top:4rpx;width:64rpx}.alert-banner__text{display:flex;flex:1;flex-direction:column;gap:16rpx}.alert-banner__title{color:#1a1a1a;font-size:44rpx;font-weight:700;line-height:1.4}.alert-banner__message{color:#666;font-size:36rpx;line-height:1.5}.alert-banner__close{align-items:center;border-radius:50%;display:flex;height:88rpx;justify-content:center;margin-left:16rpx;min-height:88rpx;min-width:88rpx;transition:background-color .2s ease-in-out;width:88rpx}.alert-banner__close:active{background-color:rgba(0,0,0,.05)}.alert-banner:active{opacity:.9}@media (prefers-reduced-motion:reduce){.alert-banner{transition:none}}