.large-input-wrapper{margin-bottom:48rpx;width:100%}.large-input__label{margin-bottom:24rpx}.large-input__label-text{color:#1a1a1a;font-size:40rpx;font-weight:500}.large-input__required{color:#e53935}.large-input{align-items:center;background:#fff;border:4rpx solid #d0d0d0;border-radius:24rpx;display:flex;height:136rpx;min-height:136rpx;padding:0 40rpx;transition:all .2s ease-in-out;width:100%}.large-input:focus-within{border-color:#01579b;box-shadow:0 0 0 6rpx rgba(1,87,155,.1)}.large-input--error{background:#fff5f5;border-color:#e53935}.large-input--error:focus-within{box-shadow:0 0 0 6rpx rgba(239,68,68,.1)}.large-input--disabled{background:#f5f5f0;border-color:#e0e0e0}.large-input--disabled .large-input__field{color:#ccc}.large-input__field{background:transparent;border:none;color:#1a1a1a;flex:1;font-size:44rpx;height:100%;outline:none}.large-input__field::-moz-placeholder{color:#999}.large-input__field::placeholder{color:#999}.large-textarea{background:#fff;border:4rpx solid #d0d0d0;border-radius:24rpx;display:flex;padding:32rpx 40rpx;transition:all .2s ease-in-out;width:100%}.large-textarea:focus-within{border-color:#01579b;box-shadow:0 0 0 6rpx rgba(1,87,155,.1)}.large-textarea--error{background:#fff5f5;border-color:#e53935}.large-textarea--error:focus-within{box-shadow:0 0 0 6rpx rgba(239,68,68,.1)}.large-textarea--disabled{background:#f5f5f0;border-color:#e0e0e0}.large-textarea--disabled .large-textarea__field{color:#ccc}.large-textarea__field{background:transparent;border:none;color:#1a1a1a;flex:1;font-size:44rpx;line-height:1.6;outline:none;width:100%}.large-textarea__field::-moz-placeholder{color:#999}.large-textarea__field::placeholder{color:#999}.large-input__error{color:#e53935;display:block;font-size:32rpx;margin-top:16rpx}@media (prefers-reduced-motion:reduce){.large-input,.large-textarea{transition:none}}