.elderly-button{align-items:center;border-radius:24rpx;box-sizing:border-box;display:flex;font-weight:600;justify-content:center;transition:all .2s ease}.elderly-button--large{font-size:44rpx;height:120rpx;min-width:400rpx;padding:0 64rpx}.elderly-button--medium{font-size:40rpx;height:104rpx;min-width:320rpx;padding:0 48rpx}.elderly-button--primary{background:linear-gradient(135deg,#01579b,#0277bd);border:none;box-shadow:0 8rpx 24rpx rgba(0,0,0,.15);color:#fff}.elderly-button--primary:active{box-shadow:0 4rpx 16rpx rgba(1,87,155,.2);transform:scale(.98)}.elderly-button--default{background:#fff;border:4rpx solid #d0d0d0;color:#1a1a1a}.elderly-button--default:active{background:#f0f0f0;border-color:#b0b0b0}.elderly-button--danger{background:linear-gradient(135deg,#e53935,#f44336);border:none;box-shadow:0 8rpx 24rpx rgba(229,57,53,.3);color:#fff}.elderly-button--danger:active{box-shadow:0 4rpx 16rpx rgba(229,57,53,.2);transform:scale(.98)}.elderly-button--disabled{opacity:.5}.elderly-button__loading{animation:spin .8s linear infinite;border:4rpx solid hsla(0,0%,100%,.3);border-radius:50%;border-top-color:#fff;height:40rpx;margin-right:16rpx;width:40rpx}.elderly-button__text{color:inherit;font-size:inherit;font-weight:inherit}.elderly-button__icon{align-items:center;display:flex;margin-right:16rpx}.elderly-button--block{width:100%}@keyframes spin{to{transform:rotate(1turn)}}