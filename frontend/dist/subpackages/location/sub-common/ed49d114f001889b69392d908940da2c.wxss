.section-title{align-items:center;display:flex;justify-content:space-between;margin:64rpx 0 40rpx}.section-title__left{align-items:center;display:flex;gap:24rpx}.section-title__indicator{background:#01579b;border-radius:6rpx;height:56rpx;width:12rpx}.section-title__text{color:#1a1a1a;font-size:52rpx;font-weight:700}.section-title__action{color:#01579b;font-size:36rpx;padding:16rpx 24rpx;transition:opacity .2s ease-in-out}.section-title__action:active{opacity:.7}