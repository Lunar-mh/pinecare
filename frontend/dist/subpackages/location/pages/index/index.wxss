.location-overview-page__scroll{max-height:calc(100vh - 440rpx)}.location-overview-page__grid,.location-overview-page__stack{display:grid;gap:32rpx}.location-overview-page__tabs{display:grid;gap:24rpx;grid-template-columns:repeat(3,minmax(0,1fr));margin-bottom:48rpx}.location-overview-page__tab{align-items:center;background:rgba(255,253,249,.88);border:2rpx solid hsla(35,39%,88%,.9);border-radius:36rpx;color:#596570;display:flex;font-size:32rpx;font-weight:600;justify-content:center;min-height:100rpx}.location-overview-page__tab--active{background:linear-gradient(135deg,#c97b55,#db916c);box-shadow:0 24rpx 56rpx rgba(201,123,85,.26);color:#fff}.location-overview-page__meta,.location-overview-page__text,.location-overview-page__title{display:block}.location-overview-page__title{color:#22303a;font-size:44rpx;font-weight:700}.location-overview-page__meta,.location-overview-page__text{color:#596570;font-size:32rpx;line-height:1.7;margin-top:16rpx}.location-overview-page__actions{display:flex;gap:24rpx;margin-top:32rpx}.location-overview-page__button{align-items:center;background:rgba(201,123,85,.12);border-radius:1998rpx;color:#c97b55;display:inline-flex;font-size:30rpx;font-weight:600;justify-content:center;min-height:88rpx;padding:0 36rpx}.location-overview-page__button--primary{background:#c97b55;color:#fff}.location-overview-page__zone-row{align-items:center;display:flex;gap:32rpx;justify-content:space-between}.location-overview-page__bottom-space{height:240rpx}