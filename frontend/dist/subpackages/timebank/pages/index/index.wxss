.detail-shell-scroll{max-height:calc(100vh - 440rpx)}.detail-card-grid,.detail-stack{display:grid;gap:32rpx}.detail-tabs{display:grid;gap:24rpx;margin-bottom:48rpx}.detail-tabs--2{grid-template-columns:repeat(2,minmax(0,1fr))}.detail-tabs--3{grid-template-columns:repeat(3,minmax(0,1fr))}.detail-tab{align-items:center;background:rgba(255,253,249,.88);border:2rpx solid hsla(35,39%,88%,.9);border-radius:36rpx;color:#596570;display:flex;font-size:32rpx;font-weight:600;justify-content:center;min-height:100rpx}.detail-tab--active,.detail-tab.is-active{background:linear-gradient(135deg,#2f6c5b,#438470);box-shadow:0 20rpx 48rpx rgba(47,108,91,.18);color:#fff}.detail-tab--family-active{background:linear-gradient(135deg,#c97b55,#db916c);box-shadow:0 24rpx 56rpx rgba(201,123,85,.26);color:#fff}.detail-badge,.detail-meta,.detail-text,.detail-title{display:block}.detail-title{color:#22303a;font-size:44rpx;font-weight:700}.detail-meta,.detail-text{color:#596570;font-size:32rpx;line-height:1.7;margin-top:16rpx}.detail-actions{display:flex;flex-wrap:wrap;gap:24rpx;margin-top:32rpx}.detail-button{align-items:center;background:rgba(47,108,91,.12);border-radius:1998rpx;color:#2f6c5b;display:inline-flex;font-size:30rpx;font-weight:600;gap:16rpx;justify-content:center;min-height:88rpx;padding:0 36rpx}.detail-button--primary{background:#2f6c5b;color:#fff}.detail-button--family{background:rgba(201,123,85,.12);color:#c97b55}.detail-button--family-primary{background:#c97b55;color:#fff}.detail-button--danger{background:rgba(215,90,74,.12);color:#d75a4a}.detail-form{display:grid;gap:32rpx}.detail-input,.detail-textarea{background:hsla(0,0%,100%,.9);border:2rpx solid hsla(35,39%,88%,.9);border-radius:36rpx;box-sizing:border-box;color:#22303a;font-size:36rpx;min-height:108rpx;padding:0 36rpx;width:100%}.detail-textarea{min-height:280rpx;padding:32rpx 36rpx}.detail-label{color:#596570;display:block;font-size:32rpx;font-weight:600;margin-bottom:20rpx}.detail-chip-row{display:flex;flex-wrap:wrap;gap:24rpx}.detail-chip{align-items:center;background:rgba(47,108,91,.08);border:2rpx solid transparent;border-radius:1998rpx;color:#2f6c5b;display:inline-flex;font-size:30rpx;font-weight:500;justify-content:center;min-height:80rpx;padding:0 28rpx}.detail-chip--active,.detail-chip.is-active{background:#2f6c5b;color:#fff}.detail-chip--family-active{background:#c97b55;color:#fff}.detail-photo-grid{display:grid;gap:32rpx;grid-template-columns:repeat(2,minmax(0,1fr))}.detail-bottom-space{height:240rpx}.timebank-moved-page{min-height:100vh}