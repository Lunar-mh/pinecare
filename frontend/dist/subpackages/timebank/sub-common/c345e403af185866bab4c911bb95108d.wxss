.elderly-button{align-items:center;border-radius:36rpx;box-sizing:border-box;display:flex;font-weight:600;justify-content:center;transition:all .22s ease}.elderly-button--large{font-size:44rpx;height:120rpx;min-width:400rpx;padding:0 64rpx}.elderly-button--medium{font-size:40rpx;height:104rpx;min-width:320rpx;padding:0 48rpx}.elderly-button--primary{background:linear-gradient(135deg,#2f6c5b,#438470);border:none;box-shadow:0 20rpx 48rpx rgba(47,108,91,.18);color:#fff}.elderly-button--primary:active{box-shadow:0 4rpx 16rpx rgba(1,87,155,.2);transform:scale(.98)}.elderly-button--default{background:#fffdf9;border:4rpx solid #ded6c7;color:#22303a}.elderly-button--default:active{background:#f7f1e8;border-color:#b0b0b0}.elderly-button--danger{background:linear-gradient(135deg,#d75a4a,#f44336);border:none;box-shadow:0 8rpx 24rpx rgba(229,57,53,.3);color:#fff}.elderly-button--danger:active{box-shadow:0 4rpx 16rpx rgba(229,57,53,.2);transform:scale(.98)}.elderly-button--disabled{opacity:.5}.elderly-button__loading{animation:spin .8s linear infinite;border:4rpx solid hsla(0,0%,100%,.3);border-radius:50%;border-top-color:#fff;height:40rpx;margin-right:16rpx;width:40rpx}.elderly-button__text{color:inherit;font-size:inherit;font-weight:inherit}.elderly-button__icon{align-items:center;display:flex;margin-right:16rpx}.elderly-button--block{width:100%}@keyframes spin{to{transform:rotate(1turn)}}