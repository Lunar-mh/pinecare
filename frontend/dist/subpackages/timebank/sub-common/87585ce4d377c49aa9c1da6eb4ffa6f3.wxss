.metric-card{background:#fff;border-radius:32rpx;box-shadow:0 8rpx 24rpx rgba(0,0,0,.1);display:flex;flex-direction:column;min-height:280rpx;padding:48rpx;transition:transform .2s}.metric-card:active{transform:scale(.98)}.metric-card--normal{background:linear-gradient(90deg,#f1f8e9,#fff);border-left:12rpx solid #43a047}.metric-card--warning{background:linear-gradient(90deg,#fff8e1,#fff);border-left:12rpx solid #fb8c00}.metric-card--danger{background:linear-gradient(90deg,#ffebee,#fff);border-left:12rpx solid #e53935}.metric-card--loading{background:#fff;border-left:12rpx solid #e0e0e0;pointer-events:none}.metric-card__skeleton{animation:skeleton-loading 1.5s ease-in-out infinite;background:#f0f0f0;border-radius:8rpx;margin-bottom:16rpx}.metric-card__skeleton--title{height:40rpx;width:40%}.metric-card__skeleton--subtitle{height:32rpx;margin-bottom:32rpx;width:60%}.metric-card__skeleton--value{height:72rpx;margin-bottom:24rpx;width:80%}.metric-card__skeleton--footer{border-radius:24rpx;height:48rpx;width:30%}.metric-card__title{color:#666;font-size:40rpx;font-weight:500;margin-bottom:24rpx}.metric-card__subtitle{color:#666;font-size:32rpx;margin-bottom:32rpx}.metric-card__value-row{align-items:baseline;display:flex;flex:1;margin-bottom:32rpx}.metric-card__value{color:#1a1a1a;font-size:80rpx;font-weight:700;letter-spacing:-2rpx;line-height:1.2}.metric-card__unit{color:#666;font-size:36rpx;font-weight:500;margin-left:12rpx}@keyframes skeleton-loading{0%{opacity:.6}50%{opacity:.3}100%{opacity:.6}}.metric-card__footer{align-items:center;display:flex;justify-content:space-between}.metric-card__status{border-radius:24rpx;font-size:32rpx;font-weight:600;padding:8rpx 24rpx}.metric-card__status--normal{background:#e8f5e9;color:#43a047}.metric-card__status--warning{background:#ffe0b2;color:#e65100}.metric-card__status--danger{background:#ffcdd2;color:#c62828}.metric-card__trend{font-size:32rpx;font-weight:500}.metric-card__trend--up{color:#e53935}.metric-card__trend--down{color:#43a047}.metric-card__trend--stable{color:#999}