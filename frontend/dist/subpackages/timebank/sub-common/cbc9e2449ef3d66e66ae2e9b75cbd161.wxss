.chart-card{background:#fff;border-radius:40rpx;box-shadow:0 8rpx 24rpx rgba(0,0,0,.1);margin-bottom:32rpx;padding:48rpx}.chart-card__header{align-items:center;display:flex;justify-content:space-between;margin-bottom:32rpx}.chart-card__title-group{align-items:baseline;display:flex;gap:24rpx}.chart-card__title{color:#1a1a1a;font-size:48rpx;font-weight:700}.chart-card__subtitle{color:#666;font-size:32rpx}.chart-card__extra{align-items:center;display:flex}.chart-card__body{width:100%}