.large-input-wrapper{margin-bottom:48rpx;width:100%}.large-input__label{margin-bottom:24rpx}.large-input__label-text{color:#22303a;font-size:40rpx;font-weight:500}.large-input__required{color:#d75a4a}.large-input{align-items:center;background:#fff;border:4rpx solid #ded6c7;border-radius:24rpx;display:flex;height:136rpx;min-height:136rpx;padding:0 40rpx;transition:all .2s ease-in-out;width:100%}.large-input:focus-within{border-color:#2f6c5b;box-shadow:0 0 0 6rpx rgba(1,87,155,.1)}.large-input--error{background:#fff5f5;border-color:#d75a4a}.large-input--error:focus-within{box-shadow:0 0 0 6rpx rgba(239,68,68,.1)}.large-input--disabled{background:#f6f1e7;border-color:#ece2d4}.large-input--disabled .large-input__field{color:#bcc5ce}.large-input__field{background:transparent;border:none;color:#22303a;flex:1;font-size:44rpx;height:100%;outline:none}.large-input__field::-moz-placeholder{color:#8d98a3}.large-input__field::placeholder{color:#8d98a3}.large-textarea{background:#fff;border:4rpx solid #ded6c7;border-radius:24rpx;display:flex;padding:32rpx 40rpx;transition:all .2s ease-in-out;width:100%}.large-textarea:focus-within{border-color:#2f6c5b;box-shadow:0 0 0 6rpx rgba(1,87,155,.1)}.large-textarea--error{background:#fff5f5;border-color:#d75a4a}.large-textarea--error:focus-within{box-shadow:0 0 0 6rpx rgba(239,68,68,.1)}.large-textarea--disabled{background:#f6f1e7;border-color:#ece2d4}.large-textarea--disabled .large-textarea__field{color:#bcc5ce}.large-textarea__field{background:transparent;border:none;color:#22303a;flex:1;font-size:44rpx;line-height:1.6;outline:none;width:100%}.large-textarea__field::-moz-placeholder{color:#8d98a3}.large-textarea__field::placeholder{color:#8d98a3}.large-input__error{color:#d75a4a;display:block;font-size:32rpx;margin-top:16rpx}@media (prefers-reduced-motion:reduce){.large-input,.large-textarea{transition:none}}