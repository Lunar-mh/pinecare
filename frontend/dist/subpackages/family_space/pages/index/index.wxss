.family-space-overview-page__scroll{max-height:calc(100vh - 440rpx)}.family-space-overview-page__grid,.family-space-overview-page__stack{display:grid;gap:32rpx}.family-space-overview-page__tabs{display:grid;gap:24rpx;grid-template-columns:repeat(3,minmax(0,1fr));margin-bottom:48rpx}.family-space-overview-page__tab{align-items:center;background:rgba(255,253,249,.88);border:2rpx solid hsla(35,39%,88%,.9);border-radius:36rpx;color:#596570;display:flex;font-size:32rpx;font-weight:600;justify-content:center;min-height:100rpx}.family-space-overview-page__tab--active{background:linear-gradient(135deg,#c97b55,#db916c);box-shadow:0 24rpx 56rpx rgba(201,123,85,.26);color:#fff}.family-space-overview-page__meta,.family-space-overview-page__photo-time,.family-space-overview-page__text,.family-space-overview-page__title{display:block}.family-space-overview-page__title{color:#22303a;font-size:44rpx;font-weight:700}.family-space-overview-page__meta,.family-space-overview-page__text{color:#596570;font-size:32rpx;line-height:1.7;margin-top:16rpx}.family-space-overview-page__actions{display:flex;gap:24rpx;margin-top:32rpx}.family-space-overview-page__button{align-items:center;background:rgba(201,123,85,.12);border-radius:1998rpx;color:#c97b55;display:inline-flex;font-size:30rpx;font-weight:600;justify-content:center;min-height:88rpx;padding:0 36rpx}.family-space-overview-page__button--primary{background:#c97b55;color:#fff}.family-space-overview-page__photo-grid{display:grid;gap:32rpx;grid-template-columns:repeat(2,minmax(0,1fr))}.family-space-overview-page__photo-card{background:#fffdf9;border:2rpx solid hsla(35,39%,88%,.9);border-radius:52rpx;box-shadow:0 24rpx 60rpx rgba(51,65,78,.08);padding:24rpx}.family-space-overview-page__photo{background:#f3ede3;border-radius:36rpx;height:440rpx;width:100%}.family-space-overview-page__photo-time{color:#8d98a3;font-size:28rpx;margin-top:20rpx}.family-space-overview-page__bottom-space{height:240rpx}