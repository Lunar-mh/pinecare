.voice-entry-btn{align-items:center;backdrop-filter:blur(16rpx);-webkit-backdrop-filter:blur(16rpx);background:hsla(0,0%,100%,.85);border:2rpx solid hsla(0,0%,100%,.3);border-radius:50%;box-shadow:0 4rpx 16rpx rgba(1,87,155,.15),inset 0 2rpx 0 hsla(0,0%,100%,.6);display:flex;height:96rpx;justify-content:center;min-height:88rpx;min-width:88rpx;transition:all .3s ease-in-out;width:96rpx}.voice-entry-btn:active{background:hsla(0,0%,100%,.95);box-shadow:0 2rpx 8rpx rgba(1,87,155,.2),inset 0 2rpx 0 hsla(0,0%,100%,.8);transform:scale(.95)}.voice-entry-btn .voice-icon{align-items:center;display:flex;height:48rpx;justify-content:center;width:48rpx}.voice-entry-btn .voice-wave{align-items:center;display:flex;gap:6rpx;height:36rpx;justify-content:center}.voice-entry-btn .voice-wave .wave-bar{animation:voiceWave 1.2s ease-in-out infinite;background:#01579b;border-radius:4rpx;width:8rpx}.voice-entry-btn .voice-wave .wave-bar-1{animation-delay:0s;height:16rpx}.voice-entry-btn .voice-wave .wave-bar-2{animation-delay:.2s;height:28rpx}.voice-entry-btn .voice-wave .wave-bar-3{animation-delay:.4s;height:20rpx}@keyframes voiceWave{0%,100%{opacity:.7;transform:scaleY(1)}50%{opacity:1;transform:scaleY(1.3)}}@media (prefers-reduced-motion:reduce){.voice-entry-btn{transition:none}.voice-entry-btn .voice-wave .wave-bar{animation:none;opacity:1}}