.voice-ai{background:#f0f4f8;display:flex;flex-direction:column;height:100vh}.voice-ai__header{align-items:center;background:#01579b;display:flex;flex-shrink:0;justify-content:space-between;padding:32rpx 40rpx}.voice-ai__header-info{align-items:center;display:flex;gap:24rpx}.voice-ai__avatar{align-items:center;background:hsla(0,0%,100%,.25);border-radius:50%;display:flex;height:96rpx;justify-content:center;width:96rpx}.voice-ai__name{color:#fff;display:block;font-size:40rpx;font-weight:700}.voice-ai__status{color:hsla(0,0%,100%,.8);display:block;font-size:28rpx;margin-top:4rpx}.voice-ai__clear{padding:16rpx 24rpx}.voice-ai__clear-text{color:hsla(0,0%,100%,.8);font-size:32rpx}.voice-ai__chat{flex:1;overflow:hidden;padding:32rpx}.voice-ai__controls{background:#fff;border-top:2rpx solid #e0e0e0;flex-shrink:0;padding:24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom))}.bubble-row{align-items:flex-end;display:flex;gap:20rpx;margin-bottom:32rpx}.bubble-row--user{flex-direction:row-reverse}.bubble-avatar{align-items:center;border-radius:50%;display:flex;flex-shrink:0;height:72rpx;justify-content:center;width:72rpx}.bubble-avatar--ai{background:#01579b}.bubble-avatar--user{background:#e65100}.bubble-avatar__text{color:#fff;font-size:28rpx;font-weight:700}.bubble{border-radius:40rpx;box-shadow:0 2rpx 4rpx rgba(0,0,0,.05);max-width:75%;padding:28rpx 36rpx;position:relative}.bubble--assistant{background:#fff;border-bottom-left-radius:8rpx;color:#1a1a1a}.bubble--user{background:linear-gradient(135deg,#01579b,#0277bd);border-bottom-right-radius:8rpx;color:#fff}.bubble--loading{padding:32rpx 40rpx}.bubble__text{display:block;font-size:40rpx;line-height:1.6}.bubble--assistant .bubble__text{color:#1a1a1a}.bubble--user .bubble__text{color:#fff}.bubble__time{display:block;font-size:24rpx;margin-top:12rpx;opacity:.6}.bubble--assistant .bubble__time{color:#999}.bubble--user .bubble__time{color:hsla(0,0%,100%,.8)}.typing-dots{align-items:center;display:flex;gap:12rpx}.typing-dots__dot{animation:typingBounce 1.2s ease-in-out infinite;background:#999;border-radius:50%;height:16rpx;width:16rpx}.typing-dots__dot:nth-child(1){animation-delay:0s}.typing-dots__dot:nth-child(2){animation-delay:.2s}.typing-dots__dot:nth-child(3){animation-delay:.4s}@keyframes typingBounce{0%,100%,60%{transform:translateY(0)}30%{transform:translateY(-16rpx)}}.quick-commands{background:#fff;border-top:2rpx solid #e0e0e0;flex-shrink:0;padding:20rpx 24rpx;white-space:nowrap}.quick-cmd-item{align-items:center;background:#f0f4f8;border-radius:48rpx;display:inline-flex;gap:12rpx;margin-right:20rpx;padding:20rpx 32rpx}.quick-cmd-item__icon{font-size:36rpx}.quick-cmd-item__label{color:#1a1a1a;font-size:36rpx;font-weight:500;white-space:nowrap}.voice-controls{align-items:center;display:flex;justify-content:space-between;padding:8rpx 0}.voice-controls__side{align-items:center;border-radius:24rpx;display:flex;flex-direction:column;gap:8rpx;padding:16rpx;width:128rpx}.voice-controls__side-icon{font-size:48rpx}.voice-controls__side-label{color:#666;font-size:28rpx}.voice-btn{align-items:center;background:linear-gradient(135deg,#01579b,#0277bd);border-radius:50%;box-shadow:0 16rpx 48rpx rgba(1,87,155,.3);display:flex;flex-direction:column;gap:12rpx;height:200rpx;justify-content:center;position:relative;transition:all .2s cubic-bezier(.4,0,.2,1);width:200rpx;z-index:10}.voice-btn::after{animation:ripple 2s infinite;border:4rpx solid rgba(1,87,155,.1);border-radius:50%;bottom:-10rpx;content:"";left:-10rpx;opacity:0;position:absolute;right:-10rpx;top:-10rpx;z-index:-1}.voice-btn--recording{background:linear-gradient(135deg,#e53935,#ff5252);box-shadow:0 16rpx 48rpx rgba(229,57,53,.4);transform:scale(1.1)}.voice-btn--recording::after{animation-play-state:running;border-color:rgba(229,57,53,.3);opacity:1}.voice-btn--processing{background:linear-gradient(135deg,#fb8c00,#ffa726);box-shadow:0 16rpx 48rpx rgba(251,140,0,.3)}.voice-btn--processing::after{display:none}.voice-btn__label{color:hsla(0,0%,100%,.95);font-size:28rpx;font-weight:500;text-shadow:0 2rpx 4rpx rgba(0,0,0,.1)}@keyframes ripple{0%{opacity:.6;transform:scale(1)}100%{opacity:0;transform:scale(1.4)}}.recording-wave{align-items:center;display:flex;gap:8rpx;height:64rpx}.recording-wave__bar{animation:waveBar .8s ease-in-out infinite;background:#fff;border-radius:4rpx;width:8rpx}.recording-wave__bar:nth-child(1){animation-delay:0s;height:24rpx}.recording-wave__bar:nth-child(2){animation-delay:.15s;height:44rpx}.recording-wave__bar:nth-child(3){animation-delay:.3s;height:64rpx}.recording-wave__bar:nth-child(4){animation-delay:.45s;height:44rpx}.recording-wave__bar:nth-child(5){animation-delay:.6s;height:24rpx}@keyframes waveBar{0%,100%{transform:scaleY(.5)}50%{transform:scaleY(1)}}.text-input-bar{align-items:center;display:flex;gap:20rpx}.text-input-bar__input{background:#f0f4f8;border:none;border-radius:48rpx;color:#1a1a1a;flex:1;font-size:36rpx;height:96rpx;padding:0 32rpx}.text-input-bar__send{align-items:center;background:#01579b;border-radius:50%;display:flex;flex-shrink:0;height:96rpx;justify-content:center;width:96rpx}.text-input-bar__cancel{padding:16rpx}.text-input-bar__cancel-text{color:#666;font-size:36rpx}