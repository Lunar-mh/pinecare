.voice-overview-page__scroll{max-height:calc(100vh - 440rpx)}.voice-overview-page__clear{background:hsla(0,0%,100%,.18);border-radius:1998rpx;color:#fff;font-size:30rpx;font-weight:600;padding:20rpx 32rpx}.voice-overview-page__hint,.voice-overview-page__message-text,.voice-overview-page__message-time{display:block}.voice-overview-page__hint{color:#596570;font-size:34rpx}.voice-overview-page__message-list{display:grid;gap:32rpx}.voice-overview-page__message{border-radius:52rpx;box-shadow:0 24rpx 60rpx rgba(51,65,78,.08);max-width:88%;padding:36rpx}.voice-overview-page__message--assistant{background:#fffdf9;border:2rpx solid hsla(35,39%,88%,.9)}.voice-overview-page__message--user{background:linear-gradient(135deg,rgba(47,108,91,.12),rgba(61,124,166,.12));border:2rpx solid rgba(47,108,91,.12);margin-left:auto}.voice-overview-page__message-text{color:#22303a;font-size:36rpx;line-height:1.7}.voice-overview-page__message-time{color:#8d98a3;font-size:28rpx;margin-top:20rpx}.voice-overview-page__input{background:hsla(0,0%,100%,.85);border:2rpx solid hsla(35,39%,88%,.9);border-radius:36rpx;color:#22303a;font-size:36rpx;min-height:112rpx;padding:0 36rpx}.voice-overview-page__send-row{display:flex;justify-content:flex-end;margin-top:32rpx}.voice-overview-page__send-btn{align-items:center;background:#2f6c5b;border-radius:1998rpx;color:#fff;display:inline-flex;font-size:30rpx;font-weight:600;justify-content:center;min-height:88rpx;padding:0 36rpx}.voice-overview-page__bottom-space{height:240rpx}