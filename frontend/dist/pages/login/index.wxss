.login-page{background:radial-gradient(circle at top,rgba(47,108,91,.18),transparent 35%),linear-gradient(180deg,#f9f6ef,#f6f1e7 45%,#f4ede2);min-height:100vh;padding:56rpx 32rpx 96rpx}.login-page--family{background:radial-gradient(circle at top,rgba(201,123,85,.22),transparent 35%),linear-gradient(180deg,#fff8f2,#f6f1e7 45%,#f5ece3)}.login-hero{padding:24rpx 16rpx 48rpx}.login-hero__badge,.login-hero__subtitle,.login-hero__title{display:block}.login-hero__badge{background:hsla(0,0%,100%,.7);border-radius:1998rpx;color:#596570;display:inline-flex;font-size:28rpx;margin-bottom:36rpx;padding:16rpx 28rpx}.login-hero__title{color:#22303a;font-size:72rpx;font-weight:700;line-height:1.2}.login-hero__subtitle{color:#596570;font-size:36rpx;line-height:1.6;margin-top:24rpx}.login-panel{background:rgba(255,253,249,.92);border:2rpx solid hsla(35,39%,88%,.9);border-radius:52rpx;box-shadow:0 36rpx 80rpx rgba(39,52,63,.14);padding:44rpx 36rpx 52rpx}.login-stage{align-items:center;display:flex;gap:20rpx;margin:16rpx 0 32rpx}.login-stage__index{align-items:center;background:rgba(47,108,91,.12);border-radius:50%;color:#2f6c5b;display:inline-flex;font-size:28rpx;font-weight:700;height:60rpx;justify-content:center;width:60rpx}.login-stage__title{color:#22303a;font-size:44rpx;font-weight:700}.login-role-grid{display:grid;gap:28rpx;grid-template-columns:1fr;margin-bottom:52rpx}.login-role-card{background:#fffdf9;border:2rpx solid hsla(35,39%,88%,.9);border-radius:36rpx;box-shadow:0 24rpx 60rpx rgba(51,65,78,.08);padding:36rpx}.login-role-card--family.login-role-card--active{border-color:rgba(201,123,85,.48);box-shadow:0 24rpx 60rpx rgba(201,123,85,.16)}.login-role-card--active{border-color:rgba(47,108,91,.46);box-shadow:0 24rpx 60rpx rgba(47,108,91,.16)}.login-role-card__icon{align-items:center;border-radius:36rpx;display:flex;height:104rpx;justify-content:center;width:104rpx}.login-role-card__icon--elder{background:rgba(47,108,91,.1)}.login-role-card__icon--family{background:rgba(201,123,85,.12)}.login-role-card__desc,.login-role-card__title{display:block}.login-role-card__title{color:#22303a;font-size:44rpx;font-weight:700;margin-top:28rpx}.login-role-card__desc{color:#596570;font-size:32rpx;line-height:1.6;margin-top:16rpx}.login-tabs{display:grid;gap:20rpx;grid-template-columns:1fr 1fr;margin-bottom:36rpx}.login-tab{align-items:center;background:hsla(38,40%,92%,.8);border-radius:1998rpx;display:flex;justify-content:center;min-height:96rpx}.login-tab--active{background:#22303a}.login-tab--active .login-tab__text{color:#fff}.login-tab__text{color:#596570;font-size:32rpx;font-weight:600}.login-form{display:flex;flex-direction:column;gap:20rpx}.login-field{align-items:center;background:#fffdf9;border:2rpx solid hsla(35,39%,88%,.9);border-radius:36rpx;display:flex;gap:20rpx;min-height:108rpx;padding:0 28rpx}.login-field--error{background:#fff8f6;border-color:rgba(215,90,74,.4)}.login-field__icon{align-items:center;display:flex;justify-content:center}.login-field__input{color:#22303a;flex:1;font-size:36rpx}.send-code-btn{align-items:center;background:rgba(47,108,91,.12);border-radius:1998rpx;display:flex;justify-content:center;min-height:76rpx;min-width:204rpx;padding:0 24rpx}.send-code-btn--disabled{opacity:.55}.send-code-btn__text{color:#2f6c5b;font-size:28rpx;font-weight:600}.login-error,.login-tip{align-items:center;display:flex;gap:16rpx;padding:8rpx 4rpx}.login-error__text,.login-tip__text{font-size:28rpx;line-height:1.5}.login-error__text{color:#d75a4a}.login-tip__text{color:#596570}.login-submit{align-items:center;background:linear-gradient(135deg,#2f6c5b,#438470);border-radius:1998rpx;box-shadow:0 20rpx 48rpx rgba(47,108,91,.18);display:flex;justify-content:center;margin-top:16rpx;min-height:112rpx}.login-submit--wechat{background:linear-gradient(135deg,#4b8d63,#62a578)}.login-submit--loading{opacity:.65}.login-submit__text{color:#fff;font-size:40rpx;font-weight:700}.wechat-panel{padding:20rpx 8rpx 0;text-align:center}.wechat-panel__icon{align-items:center;background:rgba(75,141,99,.12);border-radius:48rpx;display:flex;height:148rpx;justify-content:center;margin:16rpx auto 32rpx;width:148rpx}.wechat-panel__text{color:#596570;font-size:32rpx;line-height:1.6;margin-bottom:36rpx}.login-benefits{display:grid;gap:24rpx;grid-template-columns:1fr 1fr;margin-top:48rpx}.login-benefits__item{background:hsla(38,40%,92%,.72);border-radius:36rpx;padding:32rpx}.login-benefits__desc,.login-benefits__title{display:block}.login-benefits__title{color:#22303a;font-size:32rpx;font-weight:700}.login-benefits__desc{color:#596570;font-size:28rpx;line-height:1.5;margin-top:16rpx}