.login-page{align-items:center;background:linear-gradient(180deg,#01579b,#0277bd 35%,#f5f5f0 0);display:flex;flex-direction:column;min-height:100vh;padding-bottom:80rpx}.login-brand{align-items:center;display:flex;flex-direction:column;padding:120rpx 0 80rpx}.login-brand__logo{align-items:center;background:hsla(0,0%,100%,.25);border-radius:48rpx;box-shadow:0 16rpx 64rpx rgba(0,0,0,.15);display:flex;height:160rpx;justify-content:center;margin-bottom:32rpx;width:160rpx}.login-brand__logo-text{color:#fff;font-size:80rpx;font-weight:700;line-height:1}.login-brand__name{color:#fff;font-size:64rpx;font-weight:700;letter-spacing:8rpx;margin-bottom:16rpx}.login-brand__slogan{color:hsla(0,0%,100%,.85);font-size:36rpx;letter-spacing:2rpx}.login-card{background:#fff;border-radius:32rpx;box-shadow:0 16rpx 48rpx rgba(0,0,0,.12);margin-top:-16rpx;max-width:800rpx;padding:16rpx 0 64rpx;width:90%}.login-tabs{border-bottom:2rpx solid #e0e0e0;display:flex;margin-bottom:56rpx}.login-tab{display:flex;flex:1;justify-content:center;padding:40rpx 0 32rpx;position:relative}.login-tab__text{color:#666;font-size:40rpx;font-weight:500;transition:color .2s ease}.login-tab--active .login-tab__text{color:#01579b;font-weight:700}.login-tab--active::after{background:#01579b;border-radius:4rpx;bottom:-2rpx;content:"";height:6rpx;left:20%;position:absolute;right:20%}.login-form{padding:0 48rpx}.login-field{align-items:center;background:#f5f7fa;border:3rpx solid transparent;border-radius:24rpx;display:flex;height:104rpx;margin-bottom:16rpx;overflow:hidden;transition:border-color .15s ease}.login-field:focus-within{background:#fff;border-color:#01579b;box-shadow:0 0 0 6rpx rgba(1,87,155,.1)}.login-field--error{background:#fff5f5;border-color:#e53935!important}.login-field--code{margin-bottom:16rpx}.login-field__icon{align-items:center;display:flex;flex-shrink:0;justify-content:center;width:104rpx}.login-field__input{background:transparent;border:none;color:#1a1a1a;flex:1;font-size:40rpx;height:100%;padding:0}.login-field__input::-moz-placeholder{color:#999}.login-field__input::placeholder{color:#999}.login-error{align-items:center;background:#ffebee;border:2rpx solid rgba(229,57,53,.2);border-radius:16rpx;display:flex;gap:16rpx;margin-bottom:24rpx;padding:16rpx 24rpx}.login-error__text{color:#e53935;font-size:32rpx;font-weight:500}.send-code-btn{align-items:center;background:#01579b;border-radius:36rpx;display:flex;flex-shrink:0;height:72rpx;justify-content:center;margin-right:20rpx;padding:0 32rpx;transition:opacity .15s}.send-code-btn__text{color:#fff;font-size:32rpx;font-weight:500;white-space:nowrap}.send-code-btn--disabled{opacity:.5}.login-btn{align-items:center;background:#01579b;border-radius:24rpx;box-shadow:0 12rpx 40rpx rgba(1,87,155,.4);display:flex;height:112rpx;justify-content:center;margin-top:48rpx;transition:opacity .15s;active-opacity:.8}.login-btn--loading{opacity:.7}.login-btn__text{color:#fff;font-size:44rpx;font-weight:700;letter-spacing:12rpx}.wechat-login{align-items:center;display:flex;flex-direction:column;padding:0 48rpx}.wechat-login__illustration{align-items:center;background:#e8f5e9;border-radius:50%;display:flex;height:200rpx;justify-content:center;margin-bottom:40rpx;width:200rpx}.wechat-login__illustration-icon{font-size:104rpx;line-height:1}.wechat-login__desc{color:#666;font-size:36rpx;line-height:1.6;margin-bottom:64rpx;text-align:center;white-space:pre-line}.wechat-login__tip{color:#999;font-size:32rpx;margin-top:32rpx}.wechat-btn{align-items:center;background:#07c160!important;border:none!important;border-radius:24rpx!important;box-shadow:0 12rpx 40rpx rgba(7,193,96,.4);display:flex;gap:20rpx;height:112rpx;justify-content:center;padding:0!important;width:100%}.wechat-btn::after{display:none}.wechat-btn--loading{opacity:.7}.wechat-btn__icon{color:#fff;font-size:40rpx;font-weight:700}.wechat-btn__text{color:#fff!important;font-size:44rpx;font-weight:700;letter-spacing:4rpx}.login-agreement{align-items:center;display:flex;flex-wrap:wrap;gap:4rpx;justify-content:center;margin-top:64rpx;padding:0 48rpx}.login-agreement__text{color:#999;font-size:32rpx}.login-agreement__link{color:#01579b;font-size:32rpx}