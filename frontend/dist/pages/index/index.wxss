.home-page{background:#f5f5f0;min-height:100vh;padding-bottom:96rpx}.home-header{background:linear-gradient(135deg,#01579b,#0277bd);padding:96rpx 32rpx 64rpx}.home-header__greeting{align-items:baseline;display:flex;margin-bottom:16rpx}.home-header__hello{color:hsla(0,0%,100%,.9);font-size:56rpx;font-weight:400}.home-header__name{color:#fff;font-size:56rpx;font-weight:700}.home-header__date{color:hsla(0,0%,100%,.75);display:block;font-size:32rpx}.health-summary-card{background:#fff;border-radius:32rpx;box-shadow:0 16rpx 48rpx rgba(0,0,0,.12);margin:-32rpx 32rpx 32rpx;padding:48rpx}.health-summary-card__title{color:#1a1a1a;display:block;font-size:40rpx;font-weight:600;margin-bottom:32rpx}.health-summary-card__metrics{align-items:center;display:flex}.health-metric{align-items:center;display:flex;flex:1;gap:24rpx}.health-metric__icon-wrap{align-items:center;border-radius:24rpx;display:flex;flex-shrink:0;height:88rpx;justify-content:center;width:88rpx}.health-metric__info{flex:1}.health-metric__label{color:#666;display:block;font-size:32rpx;margin-bottom:4rpx}.health-metric__value{color:#1a1a1a;display:block;font-size:40rpx;font-weight:700}.health-metric__value--empty{color:#999;font-size:32rpx;font-weight:400}.health-metric__unit{color:#666;font-size:32rpx;font-weight:400}.health-metric__badge{border-radius:20rpx;flex-shrink:0;font-size:24rpx;font-weight:500;padding:4rpx 16rpx}.health-metric__badge--normal{background:#e8f5e9;color:#43a047}.health-metric__badge--warning{background:#fff3e0;color:#fb8c00}.health-metric__badge--danger{background:#ffebee;color:#e53935}.health-metric__divider{background:#e0e0e0;flex-shrink:0;height:96rpx;margin:0 24rpx;width:2rpx}.medication-card{background:#fff;border-left:8rpx solid #fb8c00;border-radius:32rpx;box-shadow:0 8rpx 24rpx rgba(0,0,0,.1);margin:0 32rpx 32rpx;padding:32rpx}.medication-card__header{align-items:center;display:flex;justify-content:space-between;margin-bottom:24rpx}.medication-card__header-left{align-items:center;display:flex;gap:16rpx}.medication-card__icon-wrap{align-items:center;background:#fff3e0;border-radius:16rpx;display:flex;height:64rpx;justify-content:center;width:64rpx}.medication-card__title{color:#1a1a1a;font-size:40rpx;font-weight:600}.medication-card__progress{color:#fb8c00;font-size:40rpx;font-weight:700}.medication-card__list{display:flex;flex-direction:column;gap:16rpx}.medication-card__item{align-items:center;display:flex;gap:24rpx;padding:16rpx 0}.medication-card__time{color:#666;font-size:32rpx;font-weight:500;min-width:80rpx}.medication-card__name{color:#1a1a1a;flex:1;font-size:40rpx}.medication-card__dosage{color:#999;font-size:32rpx}.medication-card__more{color:#999;display:block;font-size:32rpx;padding-top:16rpx}.medication-card__done{padding:16rpx 0}.medication-card__done-text{color:#43a047;font-size:40rpx;font-weight:500}.modules-section{margin:0 32rpx}.modules-section__title{color:#1a1a1a;display:block;font-size:40rpx;font-weight:600;margin-bottom:32rpx}.modules-grid{display:grid;gap:48rpx;grid-template-columns:repeat(3,1fr);padding-bottom:80rpx}.module-item{align-items:center;display:flex;flex-direction:column;gap:24rpx;transition:transform .1s ease}.module-item:active{opacity:.9;transform:scale(.95)}.module-item__icon-wrap{align-items:center;border-radius:40rpx;box-shadow:0 8rpx 24rpx rgba(0,0,0,.08);display:flex;height:128rpx;justify-content:center;margin-bottom:8rpx;width:128rpx}.module-item__label{color:#1a1a1a;font-size:30rpx;font-weight:500;line-height:1.5;text-align:center}