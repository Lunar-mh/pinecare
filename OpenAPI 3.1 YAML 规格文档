openapi: 3.1.0
info:
  title: 银伴全域智慧照护平台 API
  description: 银伴全域智慧照护平台后端接口规格文档，由架构师基于 GPT-5.4 生成的代码逆向分析生成。
  version: 1.0.0
servers:
  - url: /api/v1
    description: 生产环境 API 基础路径

components:
  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT

  schemas:
    ApiResponse:
      type: object
      properties:
        status:
          type: string
          enum: [ok, fail]
          description: 业务状态码
        data:
          type: object
          nullable: true
          description: 返回数据
        code:
          type: integer
          description: 错误码（仅 fail 时存在）
        message:
          type: string
          description: 错误信息（仅 fail 时存在）

    User:
      type: object
      properties:
        id: { type: integer }
        phone: { type: string }
        nickname: { type: string, nullable: true }
        avatar_url: { type: string, nullable: true }
        real_name: { type: string, nullable: true }
        age: { type: integer, nullable: true }
        gender: { type: string, enum: [male, female, unknown] }
        chronic_diseases:
          type: array
          items: { type: string }
        account_status: { type: string, enum: [active, locked, deleted] }
        created_at: { type: string, format: date-time }
        updated_at: { type: string, format: date-time }

    AuthResponse:
      type: object
      properties:
        access_token: { type: string }
        refresh_token: { type: string }
        expires_in: { type: integer, description: "有效期（秒）" }
        user: { $ref: '#/components/schemas/User' }

paths:
  # --- 身份验证相关 ---
  /auth/send-sms:
    post:
      summary: 发送短信验证码
      tags: [Auth]
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [phone, purpose]
              properties:
                phone: { type: string, pattern: "^1[3-9]\\d{9}$" }
                purpose: { type: string, enum: [register, login, bind, reset_password] }
      responses:
        200:
          description: 发送成功
          content:
            application/json:
              schema: { $ref: '#/components/schemas/ApiResponse' }

  /auth/register/phone:
    post:
      summary: 手机号注册
      tags: [Auth]
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [phone, code, password]
              properties:
                phone: { type: string }
                code: { type: string, description: "6位短信验证码" }
                password: { type: string, description: "至少8位，含大小写字母和数字" }
      responses:
        200:
          description: 注册成功
          content:
            application/json:
              schema:
                allOf:
                  - $ref: '#/components/schemas/ApiResponse'
                  - properties:
                      data: { $ref: '#/components/schemas/AuthResponse' }

  /auth/login/phone:
    post:
      summary: 手机号密码登录
      tags: [Auth]
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [phone, password]
              properties:
                phone: { type: string }
                password: { type: string }
      responses:
        200:
          description: 登录成功
          content:
            application/json:
              schema:
                allOf:
                  - $ref: '#/components/schemas/ApiResponse'
                  - properties:
                      data: { $ref: '#/components/schemas/AuthResponse' }

  /auth/refresh-token:
    post:
      summary: 刷新访问令牌
      tags: [Auth]
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [refresh_token]
              properties:
                refresh_token: { type: string }
      responses:
        200:
          description: 刷新成功
          content:
            application/json:
              schema:
                allOf:
                  - $ref: '#/components/schemas/ApiResponse'
                  - properties:
                      data:
                        type: object
                        properties:
                          access_token: { type: string }
                          refresh_token: { type: string }
                          expires_in: { type: integer }

  # --- 用户资料相关 ---
  /user/profile:
    get:
      summary: 获取个人资料
      tags: [User]
      security: [{ bearerAuth: [] }]
      responses:
        200:
          description: 获取成功
          content:
            application/json:
              schema:
                allOf:
                  - $ref: '#/components/schemas/ApiResponse'
                  - properties:
                      data: { $ref: '#/components/schemas/User' }
    put:
      summary: 更新个人资料
      tags: [User]
      security: [{ bearerAuth: [] }]
      requestBody:
        content:
          application/json:
            schema:
              type: object
              properties:
                real_name: { type: string }
                age: { type: integer, minimum: 0, maximum: 120 }
                gender: { type: string, enum: [male, female, unknown] }
                chronic_diseases: { type: array, items: { type: string } }
      responses:
        200:
          description: 更新成功
          content:
            application/json:
              schema:
                allOf:
                  - $ref: '#/components/schemas/ApiResponse'
                  - properties:
                      data: { $ref: '#/components/schemas/User' }

  /user/emergency-contacts:
    get:
      summary: 紧急联系人列表
      tags: [User]
      security: [{ bearerAuth: [] }]
      responses:
        200:
          description: 获取成功
          content:
            application/json:
              schema:
                allOf:
                  - $ref: '#/components/schemas/ApiResponse'
                  - properties:
                      data:
                        type: array
                        items:
                          type: object
                          properties:
                            id: { type: integer }
                            name: { type: string }
                            phone: { type: string }
                            relationship: { type: string }
                            is_primary: { type: boolean }
    post:
      summary: 添加紧急联系人
      tags: [User]
      security: [{ bearerAuth: [] }]
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [name, phone, relationship]
              properties:
                name: { type: string }
                phone: { type: string }
                relationship: { type: string }
                is_primary: { type: boolean }
      responses:
        200:
          description: 添加成功

  # --- 健康档案相关 ---
  /health-archive/today:
    get:
      summary: 获取当日健康数据概览
      tags: [Health]
      security: [{ bearerAuth: [] }]
      responses:
        200:
          description: 获取成功
          content:
            application/json:
              schema:
                allOf:
                  - $ref: '#/components/schemas/ApiResponse'
                  - properties:
                      data:
                        type: object
                        properties:
                          blood_pressure: { type: object }
                          heart_rate: { type: integer }
                          steps: { type: integer }
                          sleep_quality: { type: string }

  /health-archive/sync:
    post:
      summary: 同步健康设备数据
      tags: [Health]
      security: [{ bearerAuth: [] }]
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                device_id: { type: string }
                data_type: { type: string, enum: [bp, hr, steps, sleep] }
                payload: { type: object }
      responses:
        200:
          description: 同步成功

  # --- SOS 紧急求助 ---
  /sos/trigger:
    post:
      summary: 触发 SOS 警报
      tags: [SOS]
      security: [{ bearerAuth: [] }]
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [latitude, longitude]
              properties:
                latitude: { type: number }
                longitude: { type: number }
                address: { type: string }
                trigger_type: { type: string, enum: [manual, fall_detected, voice_command] }
      responses:
        200:
          description: 警报已触发
          content:
            application/json:
              schema:
                allOf:
                  - $ref: '#/components/schemas/ApiResponse'
                  - properties:
                      data:
                        type: object
                        properties:
                          event_id: { type: string }
                          status: { type: string }

  /sos/history:
    get:
      summary: 获取 SOS 历史记录
      tags: [SOS]
      security: [{ bearerAuth: [] }]
      parameters:
        - name: page
          in: query
          schema: { type: integer, default: 1 }
        - name: pageSize
          in: query
          schema: { type: integer, default: 20 }
      responses:
        200:
          description: 获取成功
